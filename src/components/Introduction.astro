<div class="wrapper">
  <div class="introduction">


    <div class="menu">

      <div class="greeting">
        <span id="hand">🖐🏼</span>
        <span id="greeting" class="visible">High five!</span>
      </div>

      <h1 class="name">Francesco</h1>
      <h1 class="surname">Arata</h1>
      <p id="subtitle"></p>
      <div class="description">
        <p>I still have to decide what to write here</p>
      </div>
    </div>

    <div class="links">

      <div class="github">
        <a href="https://github.com/francescoa" target="_blank" rel="noopener noreferrer">
          <i class="icon fa fa-github"></i>
        </a>
      </div>


    </div>
    <div class="stats">
      <div class="webpageSize">
        <p>My 402 kB piece of Internet!</p>
      </div>
    </div>
  </div>

</div>


<style>
  .wrapper {
    display: flex;
    justify-content: center;
  }

  .introduction {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    justify-content: center;
    align-items: center;
    color: white;
    font-family: var(--font-inter);
    width: 60%;
  }


  .greeting {
    font-family: monospace;
    font-size: 1.25rem;
    color: rgb(255, 208, 0);
    margin-bottom: 2.5rem;
    font-weight: 100;
  }

  .name,
  .surname {
    font-weight: 1200;
    font-size: 5rem;
    padding: 0;
    margin: 0;
    text-align: left;
    letter-spacing: 1px;
  }

  .name {
    color: #ffffff;
  }

  .surname {
    color: #21b9ff;
  }

  #subtitle {
    font-size: 1.25rem;
    color: #21b9ff;
    margin-top: 2.5rem;
    font-family: monospace;
  }

  #subtitle::before {
    content: ">  ";
    color: gray;
  }

  .stats {
    font-size: 0.8rem;
    position: absolute;
    top: -2.25rem;
    left: 0rem;
  }

  .description {
    margin-top: 2.5rem;
    color: rgb(143, 143, 143);
    font-size: 1.2rem;
    line-height: 1.5rem;
  }


  .links {
    display: flex;
    font-size: 2rem;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .icon {
    color: rgb(143, 143, 143);
  }

  #greeting {
    display: inline-block;
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
  }

  #greeting.visible {
    opacity: 1;
  }

  #greeting.chinese {
    font-family:
      "Microsoft YaHei",
      "PingFang SC",
      "Noto Sans CJK SC",
      "Source Han Sans SC",
      sans-serif;
    font-weight: 500;
  }

  #hand {
    display: inline-block;
    cursor: grab;
    margin-right: .75rem;
    user-select: none;
  }
</style>

<script>
  // handle subtitles loop

  const subtitle = document.getElementById("subtitle");
  let subtitleIndex = 0;
  const subtitles = [
    "Math",
    "Data",
    "Languages",
    "Everything"
  ];


  function changeSubtitle() {
    if (!subtitle) return;

    subtitle.textContent = subtitles[subtitleIndex];
    subtitleIndex = (subtitleIndex + 1) % subtitles.length;
  }


  changeSubtitle();
  setInterval(changeSubtitle, 1000);



  // handle greetings loop

  const greeting = document.getElementById("greeting");
  const hand = document.getElementById("hand");

  const chineseGreeting = "你好！"

  const greetings = [
    "Ciao!",
    "Hi there!",
    "Salut!",
    "Hallo!",
    chineseGreeting
  ];

  let greetingIndex = 0;
  let hideTimer;

  const visibleDuration = 500;

  if (greeting && hand) {
    hand.addEventListener("click", () => {
      clearTimeout(hideTimer);

      const isDisplayed = greeting.style.display !== "none";

      const text = greetings[greetingIndex];

      greeting.textContent = text;
      greeting.classList.toggle("chinese", text === "你好！");

      greetingIndex = (greetingIndex + 1) % greetings.length;

      if (!isDisplayed) {
        greeting.style.display = "inline-block";
        greeting.classList.remove("visible");

        void greeting.offsetWidth;
        greeting.classList.add("visible");

      } else {
        greeting.classList.add("visible");
      }

      hideTimer = setTimeout(() => {
        greeting.classList.remove("visible");
      }, visibleDuration);
    });

    greeting.addEventListener("transitionend", event => {
      if (
        event.propertyName === "opacity" &&
        !greeting.classList.contains("visible")
      ) {
        greeting.style.display = "none";
      }
    });
  }
</script>